# TagesTakt – Übersicht aller Umgebungsvariablen (nur Platzhalter!)
#
# Die Apps lesen ihre Werte aus eigenen Dateien:
#   apps/web/.env.local     (Vorlage: apps/web/.env.example)
#   apps/mobile/.env.local  (Vorlage: apps/mobile/.env.example)
# Echte Werte niemals committen. Ein privates GitHub-Repository ist kein Secret-Speicher.
#
# Öffentliche/publishable Keys ersetzen KEINE Benutzerberechtigung. Sie dürfen nur zusammen
# mit korrekt getesteter Row Level Security verwendet werden (siehe docs/security.md).

# --- Web (apps/web) ---
NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_platzhalter
# Optional, nur serverseitig: UUID des einzigen erlaubten Benutzers
TAGESTAKT_OWNER_USER_ID=

# SUPABASE_SECRET_KEY wird derzeit NICHT benötigt. Falls künftig nötig (z. B. Agent-Endpunkt),
# ausschließlich serverseitig setzen – niemals mit NEXT_PUBLIC_- oder EXPO_PUBLIC_-Präfix.
# SUPABASE_SECRET_KEY=

# --- Mobile (apps/mobile) ---
EXPO_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_platzhalter
