# TagesTakt – Verwaltungswebsite (apps/web)
# Kopieren nach apps/web/.env.local und Platzhalter ersetzen. .env.local wird nie committed.

# Supabase-Projekt-URL (lokal: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co

# NUR der öffentliche Publishable Key (sb_publishable_…) bzw. lokal der anon key.
# Er ersetzt keine Berechtigung – geschützt wird ausschließlich über RLS + Grants.
# NIEMALS einen Secret-/Service-Role-Key hier eintragen (die App bricht dann bewusst ab).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_platzhalter

# Optional, nur serverseitig: UUID des einzigen erlaubten Benutzers (Supabase Auth → Users).
# Ist sie gesetzt, werden alle anderen Konten abgewiesen – zusätzliche Absicherung.
TAGESTAKT_OWNER_USER_ID=

# Ein SUPABASE_SECRET_KEY wird von der Web-App derzeit NICHT benötigt und soll
# deshalb auch nicht gesetzt werden.
