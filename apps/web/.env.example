# TagesTakt – Verwaltungswebsite (apps/web)
# Kopieren nach apps/web/.env.local und Platzhalter ersetzen. .env.local wird nie committed.

# Supabase-Projekt-URL (lokal: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co

# NUR der öffentliche Publishable Key (sb_publishable_…) oder – z. B. bei selbstgehostetem
# Supabase – der Legacy-anon-JWT (Rolle „anon“).
# Er ersetzt keine Berechtigung – geschützt wird ausschließlich über RLS + Grants.
# NIEMALS einen Secret-/Service-Role-Key hier eintragen (die App bricht dann bewusst ab).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_platzhalter

# Nur serverseitig (nie NEXT_PUBLIC_): UUID des einzigen erlaubten Benutzers (Supabase Auth → Users).
# Lokal optional; in Produktion PFLICHT – ohne gültige UUID startet die Website nicht.
# Alle anderen Konten werden abgewiesen, auch mit gültigem Supabase-Login.
TAGESTAKT_OWNER_USER_ID=

# Ein SUPABASE_SECRET_KEY wird von der Web-App derzeit NICHT benötigt und soll
# deshalb auch nicht gesetzt werden.

# --- Claude-Connector (Remote MCP, optional) --------------------------------------------
# Beide leer → Connector abgeschaltet (404), die Website läuft unverändert.
# Ein ANTHROPIC-/Claude-API-Schlüssel wird NICHT benötigt: Claude läuft in der Claude-App und
# spricht über OAuth mit /mcp. Details: docs/claude-connector.md

# Öffentliche Adresse der Website (nur Schema + Host, in Produktion https).
# Daraus folgen die Connector-URL <adresse>/mcp und alle OAuth-Adressen.
TAGESTAKT_PUBLIC_URL=

# Nur serverseitig (nie NEXT_PUBLIC_), SECRET: Postgres-Verbindung der Rolle
# tagestakt_connector (keine Admin-, postgres- oder service_role-Verbindung – wird abgelehnt).
# Format: postgres://tagestakt_connector:…@…:5432/postgres (Passwort nur in Coolify)
CONNECTOR_DATABASE_URL=
