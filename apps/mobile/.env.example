# TagesTakt – mobile App (apps/mobile)
# Kopieren nach apps/mobile/.env.local und Platzhalter ersetzen. .env.local wird nie committed.
#
# ACHTUNG: Alle EXPO_PUBLIC_*-Werte landen im App-Bundle und sind damit öffentlich.
# Hier gehört ausschließlich der Publishable Key hinein – niemals ein Secret-/Service-Role-Key.
# Der Schutz der Daten erfolgt allein über Anmeldung + Row Level Security.

# Lokal mit Android-Emulator: http://10.0.2.2:54321
# Lokal mit echtem Gerät im WLAN: http://<IP-deines-Rechners>:54321
EXPO_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_platzhalter
