<?xml version="1.0" encoding="utf-8"?>
<!-- Generiert von apps/mobile/plugins/with-android-widget.js – nicht von Hand ändern.
     Widget „Jetzt und danach“: aktueller Block hervorgehoben, nächster Block mit Uhrzeit.
     Nur RemoteViews-taugliche Klassen (FrameLayout, LinearLayout, TextView, ImageView). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tagestakt_widget_background"
    android:clipToOutline="true"
    android:padding="@dimen/tagestakt_widget_padding">

    <LinearLayout
        android:id="@+id/tagestakt_widget_plan"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/tagestakt_widget_logo_small"
                android:layout_height="@dimen/tagestakt_widget_logo_small"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/tagestakt_widget_logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/tagestakt_widget_now"
                android:textColor="@color/tagestakt_widget_text"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tagestakt_widget_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:background="@drawable/tagestakt_widget_card_neutral"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/tagestakt_widget_bar"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/tagestakt_widget_bar"
                android:tint="@color/tagestakt_widget_tone_neutral" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tagestakt_widget_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="@color/tagestakt_widget_text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tagestakt_widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:textColor="@color/tagestakt_widget_text"
                    android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:minHeight="20dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/tagestakt_widget_next_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/tagestakt_widget_dot"
                android:tint="@color/tagestakt_widget_tone_neutral" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:maxLines="1"
                android:text="@string/tagestakt_widget_next"
                android:textColor="@color/tagestakt_widget_text_subtle"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tagestakt_widget_next_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/tagestakt_widget_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tagestakt_widget_next_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/tagestakt_widget_text_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tagestakt_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/tagestakt_widget_logo_large"
            android:layout_height="@dimen/tagestakt_widget_logo_large"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/tagestakt_widget_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tagestakt_widget_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:text="@string/app_name"
                android:textColor="@color/tagestakt_widget_text"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/tagestakt_widget_open"
                android:textColor="@color/tagestakt_widget_action"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
